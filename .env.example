# ============================================================
# WA-BAILEYS ENVIRONMENT CONFIGURATION
# ============================================================
# Salin file ini ke .env dan isi nilainya
# Jangan pernah commit file .env ke repository!
# ============================================================

# Mode environment: 'development' atau 'production'
NODE_ENV=production

# Port server berjalan
PORT=3000

# Base URL server (digunakan untuk generate URL media)
BASE_URL=http://localhost:3000

# API Key untuk mengamankan endpoint dari akses luar
# Isi dengan string acak yang kuat (misal: 64 karakter hex)
# Consumer (IELC-CRM) wajib mengirimkan header: x-api-key: <nilai ini>
API_KEY=ganti_dengan_secret_key_yang_kuat

# Proxy configuration (Wajib jika berada di balik Nginx/Cloudflare/Reverse Proxy)
# Set ke '1' jika 1 reverse proxy di depan, atau 'true'
TRUST_PROXY=1

# Webhook URL (Endpoint Laravel IELC-CRM penerima pesan masuk WhatsApp)
WEBHOOK_URL=http://localhost:8000/webhook/whatsapp/inbound

# Secret Key khusus Webhook (Opsional, dikirim di header X-WEBHOOK-SECRET ke Laravel)
WEBHOOK_SECRET=

# Batas maksimum sesi WhatsApp aktif bersamaan (Mencegah kehabisan RAM/DoS)
MAX_ACTIVE_SESSIONS=20

# Whitelist nama branch yang diizinkan (Opsional, pisahkan dengan koma. Kosongkan jika bebas)
# Contoh: ALLOWED_BRANCHES=solo,semarang,jogja
ALLOWED_BRANCHES=

# Whitelist domain CORS Frontend yang diizinkan memanggil gateway
# Pisahkan dengan koma jika lebih dari satu origin
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:8000,https://crm.ielc.co.id
